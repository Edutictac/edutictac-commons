#!/bin/sh
set -eu

APP_DIR=/opt/edutictac-commons
ENV_FILE="$APP_DIR/.env"
EXAMPLE_FILE="$APP_DIR/.env.example"
SERVICE=edutictac-commons.service
MDNS_CONF=/etc/avahi/avahi-daemon.conf

step_num=0
step_total=8
step() {
    step_num=$((step_num + 1))
    echo ""
    echo "==> [$step_num/$step_total] $1"
}

step "Generant la configuració (.env) amb claus i contrasenyes úniques..."

had_existing_env=1
if [ ! -f "$ENV_FILE" ]; then
    had_existing_env=0
    cp "$EXAMPLE_FILE" "$ENV_FILE"
fi

target_uid="${SUDO_UID:-1000}"
target_gid="${SUDO_GID:-$target_uid}"
case "$target_uid" in *[!0-9]*|'') target_uid=1000 ;; esac
case "$target_gid" in *[!0-9]*|'') target_gid="$target_uid" ;; esac

setup_token_notice="$(python3 - "$ENV_FILE" "$target_uid" "$target_gid" <<'PY'
import secrets
import sys
from pathlib import Path

path = Path(sys.argv[1])
uid, gid = sys.argv[2:4]
text = path.read_text(encoding="utf-8")
values = {
    "REPO_DIR": "/opt/edutictac-commons",
    "IMAGE_REGISTRY": "registry.edutictac.es/edutictac",
    "IMAGE_TAG": "0.1.1-alpha15",
    "ADMIN_TAG": "0.1.1-alpha13",
    "EDUHOOT_TAG": "1.0.4",
    "EDUHOOT_RESOURCES_TOKEN": secrets.token_urlsafe(48),
    "PORTAL_PORT": "80",
    "COMPOSE_PROFILES": "authentik,eduhoot,recursos",
    "RECURSOS_TAG": "0.1.1-alpha12",
    "EDUTICTAC_MDNS_NAME": "edutictac",
    "CONTENT_CATALOG_BASE_URL": "https://contenido.edutictac.es/releases/latest",
    "RESOURCES_IMPORT_TOKEN": secrets.token_urlsafe(48),
    "PUID": uid,
    "PGID": gid,
    "EDUTICTAC_ID_SECRET": secrets.token_hex(32),
    "EDUTICTAC_ID_TEACHER_TOKEN": secrets.token_urlsafe(32),
    "EDUTICTAC_ID_APP_TOKEN": secrets.token_urlsafe(32),
    "AUTHENTIK_PG_PASS": secrets.token_urlsafe(32),
    "AUTHENTIK_SECRET_KEY": secrets.token_urlsafe(64),
    "EDUTICTAC_SETUP_TOKEN": secrets.token_hex(6).upper(),
    "AUTHENTIK_BOOTSTRAP_PASSWORD": secrets.token_urlsafe(18),
    "AUTHENTIK_API_TOKEN": secrets.token_urlsafe(48),
    "ADMIN_OIDC_USERNAME": "akadmin",
    "EDUTICTAC_ID_OIDC_CLIENT_ID": "edutictac-commons",
    "EDUTICTAC_ID_OIDC_CLIENT_SECRET": secrets.token_urlsafe(48),
    "EDUTICTAC_ID_OIDC_ROLE_CLAIM": "groups",
}
replace_if = {
    "REPO_DIR": {"", "/opt/edutictac-commons"},
    "IMAGE_REGISTRY": {"edutictac", ""},
    "IMAGE_TAG": {"", "0.1.1-alpha", "0.1.1-alpha10", "0.1.1-alpha14"},
    "PUID": {"1000", ""},
    "PGID": {"1000", ""},
    "EDUTICTAC_ID_SECRET": {"change-this-local-secret", ""},
    "EDUTICTAC_ID_TEACHER_TOKEN": {"dev-teacher", ""},
    "EDUTICTAC_ID_APP_TOKEN": {"dev-app-token", ""},
    "COMPOSE_PROFILES": {"", "authentik", "eduhoot", "recursos"},
    "RECURSOS_TAG": {"", "local", "0.1.1-alpha10"},
    "ADMIN_TAG": {"", "0.1.1-alpha10", "0.1.1-alpha11", "0.1.1-alpha12"},
    "EDUHOOT_TAG": {"", "1.0.2", "1.0.3"},
    "EDUHOOT_RESOURCES_TOKEN": {"", "local-eduhoot-resources-token"},
    "EDUTICTAC_MDNS_NAME": {"", "edutictac"},
    "CONTENT_CATALOG_BASE_URL": {"", "https://contenido.edutictac.es/releases/latest"},
    "RESOURCES_IMPORT_TOKEN": {""},
    "PORTAL_PORT": {""},
    "AUTHENTIK_PG_PASS": {"change-this-authentik-db-password", ""},
    "AUTHENTIK_SECRET_KEY": {"change-this-authentik-secret-key", ""},
    "EDUTICTAC_SETUP_TOKEN": {"", "change-this-setup-token"},
    "AUTHENTIK_BOOTSTRAP_PASSWORD": {"", "change-this-authentik-password"},
    "AUTHENTIK_API_TOKEN": {"", "change-this-authentik-api-token"},
    "ADMIN_OIDC_USERNAME": {"", "akadmin"},
    "EDUTICTAC_ID_OIDC_CLIENT_ID": {"", "edutictac-commons"},
    "EDUTICTAC_ID_OIDC_CLIENT_SECRET": {"", "change-this-oidc-client-secret"},
    "EDUTICTAC_ID_OIDC_ROLE_CLAIM": {"", "roles"},
}
lines = text.splitlines()
seen = set()
new_setup_token = None
for index, line in enumerate(lines):
    if "=" not in line or line.lstrip().startswith("#"):
        continue
    key = line.split("=", 1)[0]
    current = line.split("=", 1)[1]
    if key not in values:
        continue
    if key in replace_if and current not in replace_if[key]:
        seen.add(key)
        continue
    if key == "EDUTICTAC_SETUP_TOKEN" and current in replace_if[key]:
        new_setup_token = values[key]
    lines[index] = f"{key}={values[key]}"
    seen.add(key)
for key, value in values.items():
    if key not in seen:
        lines.append(f"{key}={value}")
        if key == "EDUTICTAC_SETUP_TOKEN":
            new_setup_token = value
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
if new_setup_token:
    print(new_setup_token)
PY
 )"

chmod 600 "$ENV_FILE"

if [ "$had_existing_env" -eq 0 ] \
    && grep -q '^PORTAL_PORT=80$' "$ENV_FILE" && command -v ss >/dev/null 2>&1 \
    && ss -ltnH | grep -Eq '(^|[[:space:]])[^[:space:]]*:80[[:space:]]'; then
    python3 - "$ENV_FILE" <<'PY'
from pathlib import Path
path = Path(__import__("sys").argv[1])
lines = path.read_text(encoding="utf-8").splitlines()
lines = ["PORTAL_PORT=8082" if line.startswith("PORTAL_PORT=") else line for line in lines]
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
    echo "Avís: el port 80 ja està ocupat; Commons utilitzarà el port 8082." >&2
fi

step "Configurant les URLs públiques i el nom mDNS (edutictac.local)..."

python3 - "$ENV_FILE" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
env = {}
for line in path.read_text(encoding="utf-8").splitlines():
    if "=" in line and not line.lstrip().startswith("#"):
        key, value = line.split("=", 1)
        env[key] = value

name = env.get("EDUTICTAC_MDNS_NAME", "edutictac")
public_name = name if name.endswith(".local") else f"{name}.local"
portal_port = env.get("PORTAL_PORT", "80")
portal_base = f"http://{public_name}" if portal_port == "80" else f"http://{public_name}:{portal_port}"
authentik_base = f"http://{public_name}:{env.get('AUTHENTIK_PORT', '9000')}"
authentik_issuer = f"{authentik_base}/application/o/edutictac-commons"
authentik_discovery = "http://authentik-server:9000/application/o/edutictac-commons/.well-known/openid-configuration"
authentik_authorization = f"{authentik_base}/application/o/authorize/"
authentik_token = "http://authentik-server:9000/application/o/token/"
authentik_userinfo = "http://authentik-server:9000/application/o/userinfo/"
values = {
    "EDUTICTAC_ID_OIDC_ISSUER_URL": authentik_issuer,
    "EDUTICTAC_ID_OIDC_DISCOVERY_URL": authentik_discovery,
    "EDUTICTAC_ID_OIDC_AUTHORIZATION_URL": authentik_authorization,
    "EDUTICTAC_ID_OIDC_REDIRECT_URL": f"{portal_base}/api/auth/oidc/callback",
    "RECURSOS_APP_URL": f"http://{public_name}:8086",
    "RECURSOS_OIDC_REDIRECT_URI": f"http://{public_name}:8086/api/auth/callback",
    "EDUHOOT_AUTHENTIK_ISSUER": authentik_issuer,
    "EDUHOOT_AUTHENTIK_DISCOVERY_URL": authentik_discovery,
    "EDUHOOT_AUTHENTIK_AUTHORIZATION_URL": authentik_authorization,
    "EDUHOOT_AUTHENTIK_TOKEN_URL": authentik_token,
    "EDUHOOT_AUTHENTIK_USERINFO_URL": authentik_userinfo,
    "EDUHOOT_AUTHENTIK_CLIENT_ID": env.get("EDUTICTAC_ID_OIDC_CLIENT_ID", ""),
    "EDUHOOT_AUTHENTIK_CLIENT_SECRET": env.get("EDUTICTAC_ID_OIDC_CLIENT_SECRET", ""),
    "PLAY_PUBLIC_URL": f"http://{public_name}:8084",
    "EDUHOOT_PUBLIC_BASE_URL": f"http://{public_name}:8090",
    "EDUHOOT_AUTHENTIK_REDIRECT_URI": f"http://{public_name}:8090/api/auth/authentik/callback",
    "PLAY_ALLOWED_HOSTS": f"{public_name},localhost",
}
replace_if = {
    "EDUTICTAC_ID_OIDC_ISSUER_URL": {"", "https://auth.example/application/o/commons/", "http://edutictac:9000/application/o/edutictac-commons"},
    "EDUTICTAC_ID_OIDC_DISCOVERY_URL": {""},
    "EDUTICTAC_ID_OIDC_AUTHORIZATION_URL": {"", "http://edutictac:9000/application/o/authorize/"},
    "EDUTICTAC_ID_OIDC_REDIRECT_URL": {"", "https://commons.example/api/auth/oidc/callback", "http://edutictac/api/auth/oidc/callback"},
    "RECURSOS_APP_URL": {"", "http://localhost:8086"},
    "RECURSOS_OIDC_REDIRECT_URI": {"", "http://localhost:8086/api/auth/callback"},
    "PLAY_PUBLIC_URL": {"", "http://localhost:8084"},
    "EDUHOOT_PUBLIC_BASE_URL": {"", "http://localhost:8090"},
    "EDUHOOT_AUTHENTIK_REDIRECT_URI": {"", "http://localhost:8090/api/auth/authentik/callback"},
    "EDUHOOT_AUTHENTIK_ISSUER": {""},
    "EDUHOOT_AUTHENTIK_DISCOVERY_URL": {""},
    "EDUHOOT_AUTHENTIK_AUTHORIZATION_URL": {""},
    "EDUHOOT_AUTHENTIK_TOKEN_URL": {""},
    "EDUHOOT_AUTHENTIK_USERINFO_URL": {""},
    "EDUHOOT_AUTHENTIK_CLIENT_ID": {""},
    "EDUHOOT_AUTHENTIK_CLIENT_SECRET": {""},
    "PLAY_ALLOWED_HOSTS": {"", "play.local.test,localhost"},
}
lines = path.read_text(encoding="utf-8").splitlines()
seen = set()
for index, line in enumerate(lines):
    if "=" not in line or line.lstrip().startswith("#"):
        continue
    key, current = line.split("=", 1)
    if key not in values:
        continue
    if current in replace_if[key]:
        lines[index] = f"{key}={values[key]}"
    seen.add(key)
for key, value in values.items():
    if key not in seen:
        lines.append(f"{key}={value}")
path.write_text("\n".join(lines) + "\n", encoding="utf-8")
PY

python3 - "$ENV_FILE" "$MDNS_CONF" <<'PY'
import re
import sys
from pathlib import Path

env_path, conf_path = map(Path, sys.argv[1:])
env = {}
for line in env_path.read_text(encoding="utf-8").splitlines():
    if "=" in line and not line.lstrip().startswith("#"):
        key, value = line.split("=", 1)
        env[key] = value.strip()
name = re.sub(r"[^a-zA-Z0-9-]", "-", env.get("EDUTICTAC_MDNS_NAME", "edutictac")).strip("-") or "edutictac"
if conf_path.exists():
    lines = conf_path.read_text(encoding="utf-8").splitlines()
else:
    lines = []
found = False
in_server = False
output = []
for line in lines:
    if re.match(r"^\s*\[", line):
        in_server = line.strip() == "[server]"
    if in_server and re.match(r"^\s*#?\s*host-name\s*=", line):
        output.append(f"host-name={name}")
        found = True
    else:
        output.append(line)
if not found:
    try:
        index = next(i for i, line in enumerate(output) if line.strip() == "[server]") + 1
    except StopIteration:
        output = ["[server]"] + output
        index = 1
    output.insert(index, f"host-name={name}")
conf_path.write_text("\n".join(output) + "\n", encoding="utf-8")
PY

if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files avahi-daemon.service >/dev/null 2>&1; then
    systemctl enable avahi-daemon.service >/dev/null 2>&1 || true
    systemctl restart avahi-daemon.service >/dev/null 2>&1 || true
fi

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

step "Preparant els directoris de dades i còpies de seguretat..."

mkdir -p "$APP_DIR/data" "$APP_DIR/data/play" "$APP_DIR/data/recursos-api" \
    "$APP_DIR/data/authentik" "$APP_DIR/data/authentik-templates" \
    "$APP_DIR/data/content-sync" \
    "$APP_DIR/data/eduhoot-mongo" "$APP_DIR/data/eduhoot-uploads" \
    "$APP_DIR/data/eduhoot-logs" "$APP_DIR/backups" "$APP_DIR/dist"
chown -R root:root "$APP_DIR"
chown -R "$target_uid:$target_gid" "$APP_DIR/data"
chown "$target_uid:$target_gid" "$APP_DIR/backups" "$APP_DIR/dist"
chmod 700 "$APP_DIR/data" "$APP_DIR/backups"

step "Comprovant Docker Compose..."

if command -v docker >/dev/null 2>&1 && ! docker compose version >/dev/null 2>&1; then
    echo "Avís: falta el complement Docker Compose v2 ('docker compose')." >&2
    echo "El servei no arrencarà fins que s'instal·le. En Ubuntu/LliureX:" >&2
    echo "  sudo apt install docker-compose-v2" >&2
    echo "Després reinicia el servei: sudo systemctl restart $SERVICE" >&2
fi

step "Carregant les imatges Docker incloses a l'instal·lador (si n'hi ha)..."

bundle="$(ls "$APP_DIR"/dist/edutictac-commons-images-*.tar.gz 2>/dev/null | head -n 1 || true)"
if [ -n "$bundle" ] && command -v docker >/dev/null 2>&1; then
    if docker load -i "$bundle"; then
        echo "Imatges carregades des de l'instal·lador: $(basename "$bundle")"
    else
        echo "Avís: no s'han pogut carregar les imatges incloses; es descarregaran del registre." >&2
    fi
fi

step "Descarregant les imatges Docker (es mostra el progrés de cada capa)..."

if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    if ! (cd "$APP_DIR" && docker compose --env-file "$ENV_FILE" -f compose.yml pull); then
        echo "Avís: no s'han pogut descarregar totes les imatges Docker ara mateix;" >&2
        echo "es tornarà a intentar automàticament en arrencar el servei." >&2
    fi
fi

step "Activant i arrencant el servei..."

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload
    systemctl enable "$SERVICE" >/dev/null 2>&1 || true
    if ! systemctl restart "$SERVICE"; then
        echo "Avís: no s'ha pogut arrencar EduTicTac Commons." >&2
        echo "Revisa el registre del servei i executa: systemctl start $SERVICE" >&2
    fi
fi

# systemctl restart already recreates the stack. A second restart here can
# interrupt first-run migrations before the blueprint has been applied.

AUTHENTIK_API_TOKEN="$(python3 - "$ENV_FILE" <<'PY'
import sys
from pathlib import Path

for line in Path(sys.argv[1]).read_text(encoding="utf-8").splitlines():
    if line.startswith("AUTHENTIK_API_TOKEN="):
        print(line.split("=", 1)[1])
        break
PY
)"

if [ -n "$AUTHENTIK_API_TOKEN" ] && command -v docker >/dev/null 2>&1; then
    step "Esperant que Authentik estiga llest per crear el token d'API d'administració (fins a 60 s)..."

    authentik_attempt=0
    while [ "$authentik_attempt" -lt 30 ]; do
        if (
            cd "$APP_DIR" &&
            docker compose exec -T authentik-worker ak shell -c \
                'from authentik.core.models import Token, User; import os; u=User.objects.get(username="akadmin"); g=u.groups.get(name="administrador"); g.is_superuser=True; g.save(update_fields=["is_superuser"]); Token.objects.update_or_create(identifier="edutictac-commons-admin", defaults={"user":u, "intent":"api", "key":os.environ["AUTHENTIK_API_TOKEN"], "description":"Commons admin API"})' \
                >/dev/null 2>&1
        ); then
            break
        fi
        authentik_attempt=$((authentik_attempt + 1))
        sleep 2
    done
fi

if [ -n "$setup_token_notice" ]; then
    if [ -t 1 ] && command -v tput >/dev/null 2>&1 && [ "$(tput colors 2>/dev/null || echo 0)" -ge 8 ]; then
        bold="$(tput bold)"; green="$(tput setaf 2)"; yellow="$(tput setaf 3)"; reset="$(tput sgr0)"
    else
        bold=""; green=""; yellow=""; reset=""
    fi
    border="${green}============================================================${reset}"

    echo ""
    echo "$border"
    echo "${bold}${green}EduTicTac Commons requereix una activació inicial.${reset}"
    echo "Obri ${bold}http://edutictac.local/${reset} i usa aquest codi una sola vegada:"
    echo ""
    echo "   ${bold}${yellow}${setup_token_notice}${reset}"
    echo ""
    echo "$border"
    echo ""

    if command -v notify-send >/dev/null 2>&1 && [ -n "${SUDO_USER:-}" ]; then
        notify_uid="$(id -u "$SUDO_USER" 2>/dev/null || true)"
        if [ -n "$notify_uid" ] && [ -S "/run/user/$notify_uid/bus" ]; then
            su -s /bin/sh -c "DBUS_SESSION_BUS_ADDRESS='unix:path=/run/user/$notify_uid/bus' notify-send 'EduTicTac Commons' 'Activació inicial pendent: obri http://edutictac.local/'" "$SUDO_USER" >/dev/null 2>&1 || true
        fi
    fi
elif [ "$had_existing_env" -eq 1 ]; then
    echo ""
    echo "EduTicTac Commons ja estava configurat: el codi d'activació no es torna"
    echo "a mostrar en les actualitzacions. Si encara no s'ha activat, recupera'l amb:"
    echo "   sudo grep '^EDUTICTAC_SETUP_TOKEN=' $ENV_FILE"
    echo "Si ja es va activar, no cal fer res."
fi

exit 0
