# EduTicTac Commons local stack
# Copia este fichero a .env y cambia los valores antes de usarlo fuera de una demo local.

COMPOSE_PROJECT_NAME=edutictac-commons
PORTAL_PORT=8082
PLAY_PORT=8084
RECURSOS_PORT=8086
IMAGE_REGISTRY=edutictac
IMAGE_TAG=0.1.1-alpha
# Canal d'actualitzacions: stable (nomes X.Y.Z), testing (inclou preversions)
# o dev (qualsevol tag versionat/no-latest). En centres, stable per defecte.
UPDATE_CHANNEL=testing

# UID/GID amb que arranca id-api dins del contenidor. Per defecte 1000
# (usuari habitual d'un escriptori o servidor d'un sol admin), perque els
# fitxers de data/ (id.db, backups) queden a nom de qui opera la maquina i no
# d'un UID intern arbitrari. Si el teu usuari no es 1000, ajusta amb `id -u`
# i `id -g`.
PUID=1000
PGID=1000

EDUTICTAC_ID_DB=/data/id.db
EDUTICTAC_ID_SECRET=change-this-local-secret
EDUTICTAC_ID_TEACHER_TOKEN=dev-teacher
EDUTICTAC_ID_APP_TOKEN=dev-app-token
EDUTICTAC_ID_COOKIE_SECURE=0
EDUTICTAC_ID_PIN_HASH_ITERATIONS=60000
# OIDC opcional con Authentik. Dejar vacio para mantener solo codigo + PIN.
EDUTICTAC_ID_OIDC_ISSUER_URL=
EDUTICTAC_ID_OIDC_DISCOVERY_URL=
EDUTICTAC_ID_OIDC_AUTHORIZATION_URL=
EDUTICTAC_ID_OIDC_CLIENT_ID=
EDUTICTAC_ID_OIDC_CLIENT_SECRET=
EDUTICTAC_ID_OIDC_REDIRECT_URL=https://commons.example/api/auth/oidc/callback
EDUTICTAC_ID_OIDC_SCOPES=openid profile groups
EDUTICTAC_ID_OIDC_ROLE_CLAIM=roles

# Authentik local opcional (sin Redis). Activar con COMPOSE_PROFILES=authentik.
# Genera ambos secretos con: openssl rand -base64 48
AUTHENTIK_TAG=2026.8.2
AUTHENTIK_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
AUTHENTIK_PG_DB=authentik
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=change-this-authentik-db-password
AUTHENTIK_SECRET_KEY=change-this-authentik-secret-key

# Modul opcional EduHoot (Fase 4). Deixa buit per no arrancar-lo.
# Per activar-lo: COMPOSE_PROFILES=eduhoot
COMPOSE_PROFILES=
# Para activar el Banc de recursos local: COMPOSE_PROFILES=recursos
RECURSOS_TAG=local
RECURSOS_SECRET=local-recursos-secret
RECURSOS_DOCUMENTS_MAX_BYTES=26214400
EDUTICTAC_ID_APP_TOKEN=dev-app-token
RECURSOS_COOKIE_SECURE=0
RECURSOS_APP_URL=http://edutictac.local:8086
PLAY_INGEST_TOKEN=local-play-ingest-token
EDUHOOT_RESOURCES_URL=http://eduhoot:3000
EDUHOOT_RESOURCES_TOKEN=local-eduhoot-resources-token
PLAY_ALLOWED_HOSTS=play.local.test,localhost
# Opcional: activa el botón de publicación de Play cuando Recursos esté activo.
RECURSOS_API_URL=http://recursos-api:8004
RECURSOS_OIDC_REDIRECT_URI=http://edutictac.local:8086/api/auth/callback
RECURSOS_OIDC_SCOPE=openid profile email
RECURSOS_OIDC_ADMIN_EMAILS=
PLAY_PUBLIC_URL=http://edutictac.local:8084
# Visibilidad por defecto de actividades con identidad validada.
PLAY_DEFAULT_VISIBILITY=private
# Las actividades creadas sin sesión docente son públicas y caducan tras este plazo.
PLAY_ANONYMOUS_TTL_SECONDS=86400
# Solo configurar cuando un proxy OIDC fiable establece esta cabecera.
PLAY_TRUSTED_IDENTITY_HEADER=
EDUHOOT_PORT=8090
EDUHOOT_TAG=1.0.2
# Si es 0, l'alumnat pot entrar amb nom curt o amb codi+PIN Commons.
# Si es 1, nomes pot entrar amb codi+PIN Commons.
EDUHOOT_ID_AUTH_REQUIRED=0
# SSO docente EduHoot con Authentik. Dejar vacio para desactivarlo.
EDUHOOT_AUTHENTIK_ISSUER=
EDUHOOT_AUTHENTIK_DISCOVERY_URL=
EDUHOOT_AUTHENTIK_AUTHORIZATION_URL=
EDUHOOT_AUTHENTIK_TOKEN_URL=
EDUHOOT_AUTHENTIK_USERINFO_URL=
EDUHOOT_AUTHENTIK_CLIENT_ID=
EDUHOOT_AUTHENTIK_CLIENT_SECRET=
EDUHOOT_AUTHENTIK_REDIRECT_URI=http://edutictac.local:8090/api/auth/authentik/callback
EDUHOOT_AUTHENTIK_SCOPE=openid profile email groups
EDUHOOT_AUTHENTIK_ROLE_CLAIM=groups
EDUHOOT_AUTHENTIK_TEACHER_ROLES=profesor,teacher,docente,administrador,admin
# En el stack Commons Google queda oculto y desactivado; producción puede dejarlo a 0.
EDUHOOT_AUTHENTIK_ONLY=1
EDUHOOT_PUBLIC_BASE_URL=http://edutictac.local:8090
# Font per al boto d'admin "Importar activitats publiques" (contingut de prova).
# Deixa-ho buit per amagar el boto i desactivar la funcio.
EDUHOOT_PUBLIC_IMPORT_SOURCE=https://eduhoot.edutictac.es

# Panell d'administracio (/admin), servei "admin" del compose. Nomes escolta
# en 127.0.0.1 del host per defecte: per a accedir-hi en remot cal un tunel
# SSH o Tailscale, mai exposar-lo directament a internet. CANVIA el token
# per defecte abans de fer servir el stack fora d'una demo local: qui el
# tinga pot crear backups i activar/desactivar el timer de backups
# automatics en aquest host.
ADMIN_OIDC_USERNAME=akadmin
AUTHENTIK_API_URL=http://authentik-server:9000/api/v3
# Token técnico de Authentik, solo para el servicio admin; nunca se expone al navegador.
AUTHENTIK_API_TOKEN=
AUTHENTIK_TEACHER_GROUP=profesor
# Catálogo compartido de contenidos. Déjalo vacío hasta publicar el catálogo.
CONTENT_CATALOG_BASE_URL=
ADMIN_PORT=8091
