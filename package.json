{
  "name": "edutictac-commons-checks",
  "private": true,
  "version": "0.1.1-alpha",
  "scripts": {
    "test": "playwright test",
    "test:i18n": "playwright test tests/browser/language.spec.js",
    "test:play": "node --test tests/unit/play-service-worker.test.cjs && playwright test --config=playwright.play.config.js",
    "test:moodle": "playwright test --config=playwright.moodle.config.js",
    "build:rebost": "vite build --config vite.rebost.config.mjs",
    "build:teacher": "vite build --config vite.teacher.config.mjs",
    "build:portal": "npm run build:rebost && npm run build:teacher && npm run build:student && npm run build:admin && npm run build:play",
    "build:student": "vite build --config vite.student.config.mjs",
    "build:admin": "vite build --config vite.admin.config.mjs",
    "build:play": "vite build --config vite.play.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "vite": "8.3.5",
    "@vitejs/plugin-vue": "6.0.10"
  },
  "dependencies": {
    "vue": "3.5.44"
  }
}
